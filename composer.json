    "description": "A PocketMine-MP plugin for changing player game modes",
    "license": "GPL-3.0-only",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.1",
        "pocketmine/pocketmine-mp": "^5.44.3"
    },
    "autoload-dev": {
